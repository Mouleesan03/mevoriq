# Public origin used for share links, QR codes and auth redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase — leave all three empty to run on the local development store.
# Project Settings → API keys. The SECRET key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Platform admins (comma-separated emails) who can open /admin
MEVORIQ_ADMIN_EMAILS=

# Wallet passes (optional; the buttons appear only when a provider is set up). See docs/deploy.md §6.
# Apple Wallet: Pass Type ID certificate from developer.apple.com. PEM files, base64-encoded on one line.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
# Google Wallet: issuer ID from the Google Pay & Wallet Console, plus a service account with the Wallet Object Issuer role.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
